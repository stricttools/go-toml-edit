{
  "version": "0.5.0",
  "description": "Zero-dep TOML editing library for Go with comment preservation",
  "repo": "https://github.com/stricttools/go-toml-edit",
  "base_url": "https://smmh.dev/go-toml-edit",
  "source": [
    {
      "path": ".",
      "language": "go"
    }
  ],
  "gen": {
    "exclude": [
      "scripts"
    ]
  },
  "docs": ".strictmetadata/docs/",
  "output": ".strictmetadata/.docs-cache/build/",
  "versions": [
    {
      "version": "0.5.0"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "topology": {
    "slug": "go-toml-edit",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  },
  "root_files": [
    {
      "template": ".strictmetadata/docs/_README.md",
      "outputs": [
        "README.md"
      ]
    },
    {
      "template": ".strictmetadata/docs/_CLAUDE.md",
      "outputs": [
        ".claude/CLAUDE.md"
      ]
    }
  ],
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  }
}

{
  "version": "0.4.3",
  "description": "Zero-dep TOML editing library for Go with comment preservation",
  "repo": "https://github.com/stricttools/go-toml-edit",
  "base_url": "https://smmh.dev/go-toml-edit",
  "source": [
    {
      "path": ".",
      "language": "go"
    }
  ],
  "gen": {
    "exclude": [
      "scripts"
    ]
  },
  "docs": "stricttools/docs/",
  "output": "stricttools/.docs-cache/build/",
  "versions": [
    {
      "version": "0.4.3"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "topology": {
    "slug": "go-toml-edit",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://blog.smmh.dev"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache"
  },
  "root_files": [
    "stricttools/docs/_README.md",
    "stricttools/docs/_CLAUDE.md"
  ],
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  }
}
